# Salin menjadi .env lalu sesuaikan. Project ini TIDAK memerlukan source code backend.

# --- Opsi 1: parameter terpisah (MySQL backend) ---
# Disarankan memakai user MySQL read-only (GRANT SELECT), dashboard hanya membaca.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slop
DB_USER=slop_readonly
DB_PASSWORD=ganti-saya

# --- Opsi 2: satu URL SQLAlchemy (jika diisi, mengalahkan opsi 1) ---
# DB_URL=mysql+pymysql://user:password@host:3306/slop?charset=utf8mb4
# Mode demo tanpa MySQL (setelah `python scripts/seed_demo.py`):
# DB_URL=sqlite:///demo.sqlite3

TIMEZONE=Asia/Jakarta
# Interval telemetri firmware (detik), dipakai menghitung kelengkapan data
TELEMETRY_INTERVAL_SECONDS=5
# Perangkat dianggap offline jika tidak mengirim data lebih lama dari ini (sama dengan backend)
DEVICE_ONLINE_WINDOW_SECONDS=20
